# OpenRouter
OPENROUTER_API_KEY=your_openrouter_key

# Server Port
PORT=3000

# Gmail MCP Configuration
# The Docker image to use (default: yashtekwani/gmail-mcp)
GMAIL_MCP_IMAGE=yashtekwani/gmail-mcp

# Gmail Credentials (App Password required if using yashtekwani/gmail-mcp)
GMAIL_EMAIL_ADDRESS=your-email@gmail.com
GMAIL_APP_PASSWORD=your-app-password

# Optional: IMAP/SMTP overrides
# GMAIL_IMAP_HOST=imap.gmail.com
# GMAIL_IMAP_PORT=993
# GMAIL_SMTP_HOST=smtp.gmail.com
# GMAIL_SMTP_PORT=587
